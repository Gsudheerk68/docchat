# Choose one: google | anthropic | openai | deepseek | ollama
LLM_PROVIDER=google
# Leave blank to use a sensible default for the provider
LLM_MODEL=
TEMPERATURE=0.3

GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
# ollama (free, local): OLLAMA_BASE_URL=http://host.docker.internal:11434/v1

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# --- RAG ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=4
DATA_DIR=./data
